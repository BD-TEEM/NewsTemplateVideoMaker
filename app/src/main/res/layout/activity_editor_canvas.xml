<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Top Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/dark_gray"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Video Editor"
        app:titleTextColor="@color/white" />

    <!-- Main Canvas Container -->
    <FrameLayout
        android:id="@+id/canvasContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/canvas_background"
        app:layout_constraintBottom_toTopOf="@id/bottomControlsContainer"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <!-- Video Canvas Preview (AspectRatio 1080x1920) -->
        <FrameLayout
            android:id="@+id/videoCanvas"
            android:layout_width="300dp"
            android:layout_height="534dp"
            android:layout_gravity="center"
            android:background="@color/dark_gray"
            android:clipChildren="true">

            <!-- Top Video Zone -->
            <FrameLayout
                android:id="@+id/topVideoZone"
                android:layout_width="300dp"
                android:layout_height="250dp"
                android:layout_gravity="top"
                android:background="@drawable/zone_border"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/topVideoThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Top video zone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+ Tap to add video"
                    android:textColor="@color/light_gray"
                    android:textSize="14sp"
                    android:id="@+id/topVideoPlaceholder" />

            </FrameLayout>

            <!-- Middle Ticker Bar -->
            <FrameLayout
                android:id="@+id/tickerZone"
                android:layout_width="300dp"
                android:layout_height="34dp"
                android:layout_gravity="center_vertical"
                android:layout_marginTop="250dp"
                android:background="@color/ticker_bg">

                <TextView
                    android:id="@+id/tickerText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical|center_horizontal"
                    android:text="Breaking News..."
                    android:textColor="@color/ticker_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:ellipsize="marquee"
                    android:singleLine="true"
                    android:marqueeRepeatLimit="marquee_forever" />

            </FrameLayout>

            <!-- Bottom Video Zone -->
            <FrameLayout
                android:id="@+id/bottomVideoZone"
                android:layout_width="300dp"
                android:layout_height="250dp"
                android:layout_gravity="bottom"
                android:background="@drawable/zone_border"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/bottomVideoThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="Bottom video zone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="+ Tap to add video"
                    android:textColor="@color/light_gray"
                    android:textSize="14sp"
                    android:id="@+id/bottomVideoPlaceholder" />

            </FrameLayout>

        </FrameLayout>

    </FrameLayout>

    <!-- Bottom Controls Panel -->
    <HorizontalScrollView
        android:id="@+id/bottomControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@color/dark_gray"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- Crop Button -->
            <Button
                android:id="@+id/btnCrop"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="4dp"
                android:text="Crop"
                android:textSize="12sp"
                android:backgroundTint="@color/control_btn_bg"
                android:textColor="@color/white" />

            <!-- Sticker Button -->
            <Button
                android:id="@+id/btnSticker"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="4dp"
                android:text="Sticker"
                android:textSize="12sp"
                android:backgroundTint="@color/control_btn_bg"
                android:textColor="@color/white" />

            <!-- Audio Button -->
            <Button
                android:id="@+id/btnAudio"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="4dp"
                android:text="Audio"
                android:textSize="12sp"
                android:backgroundTint="@color/control_btn_bg"
                android:textColor="@color/white" />

            <!-- Ticker Button -->
            <Button
                android:id="@+id/btnTicker"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="4dp"
                android:text="Ticker"
                android:textSize="12sp"
                android:backgroundTint="@color/control_btn_bg"
                android:textColor="@color/white" />

            <!-- Export Button -->
            <Button
                android:id="@+id/btnExport"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="4dp"
                android:text="Export"
                android:textSize="12sp"
                android:backgroundTint="@color/primary_blue"
                android:textColor="@color/white" />

        </LinearLayout>

    </HorizontalScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
